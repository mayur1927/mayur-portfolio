# ---- GitHub (server-side only) ----
# Your GitHub username, used to fetch public profile + repo data.
GITHUB_USERNAME=
# Optional but recommended: a GitHub personal access token (no scopes needed
# for public data) so the contribution calendar (GraphQL API) can be fetched.
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-side only.
GITHUB_TOKEN=

# ---- Public social links (safe to expose to the browser) ----
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_EMAIL=mayurchaudhari1927@gmail.com
